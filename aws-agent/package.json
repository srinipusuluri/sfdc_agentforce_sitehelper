{
  "name": "claude-salesforce-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A Claude agent that runs on AWS Lambda and is called from Salesforce (LWC, Experience Cloud sites) through Apex.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/handler.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "local": "tsx src/local.ts",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/aws-sdk": "^1.1.2",
    "@anthropic-ai/bedrock-sdk": "^1.1.3",
    "@anthropic-ai/sdk": "^1.13.0",
    "@aws-sdk/client-secrets-manager": "^3.600.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
